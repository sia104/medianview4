{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/adlc/candidate-lesson.schema.json",
  "title": "ADLC Candidate Lesson",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "created_at",
    "observation",
    "supporting_evidence",
    "why_it_matters",
    "proposed_target",
    "status",
    "automatically_applied"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lesson_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "observation": {"type": "string", "minLength": 1},
    "supporting_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["run_id", "path", "sha256"],
        "properties": {
          "run_id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "why_it_matters": {"type": "string", "minLength": 1},
    "proposed_target": {
      "enum": ["product-test", "deterministic-adlc-control", "skill-change", "agents-rule", "ci-change", "eval", "documentation", "no-action"]
    },
    "status": {"const": "proposed"},
    "automatically_applied": {"const": false}
  },
  "additionalProperties": false
}
